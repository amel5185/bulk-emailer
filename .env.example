# Wajib. String acak panjang (min 32 karakter) untuk menandatangani sesi login.
AUTH_SECRET=
# Wajib. Kredensial login dashboard (akun admin tunggal).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Wajib. String acak panjang untuk mengenkripsi App Password Gmail (AES-256-GCM).
ENCRYPTION_KEY=
# Opsional tapi SANGAT disarankan di Vercel (Upstash Redis gratis via Vercel Marketplace).
# Tanpa ini data disimpan di file lokal (.data/db.json) dan hilang di Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
